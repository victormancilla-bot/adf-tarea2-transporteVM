{
	"name": "df_bronze_vehiculos",
	"properties": {
		"folder": {
			"name": "Bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_vehiculos_csv",
						"type": "DatasetReference"
					},
					"name": "csv"
				},
				{
					"dataset": {
						"referenceName": "Bronze_vehiculo_sql",
						"type": "DatasetReference"
					},
					"name": "sql"
				},
				{
					"dataset": {
						"referenceName": "bronze_vehiculo_2022_xls",
						"type": "DatasetReference"
					},
					"name": "xls1"
				},
				{
					"dataset": {
						"referenceName": "bronze_vehiculo_2023_xls",
						"type": "DatasetReference"
					},
					"name": "xls2"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "union1"
				},
				{
					"name": "union2"
				},
				{
					"name": "union3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          nro_bus as string,",
				"          placa as string,",
				"          tipo_bus as string,",
				"          capacidad as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> csv",
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sql",
				"source(output(",
				"          nro_bus as string,",
				"          placa as string,",
				"          tipo_bus as string,",
				"          capacidad as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls1",
				"source(output(",
				"          nro_bus as string,",
				"          placa as string,",
				"          tipo_bus as string,",
				"          capacidad as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> xls2",
				"csv select(mapColumn(",
				"          VehiculoId = nro_bus,",
				"          Placa = placa,",
				"          TipoVehiculo = tipo_bus,",
				"          CapacidadEfectiva = capacidad,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"xls1 select(mapColumn(",
				"          VehiculoId = nro_bus,",
				"          Placa = placa,",
				"          TipoVehiculo = tipo_bus,",
				"          CapacidadEfectiva = capacidad,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"xls2 select(mapColumn(",
				"          VehiculoId = nro_bus,",
				"          Placa = placa,",
				"          TipoVehiculo = tipo_bus,",
				"          CapacidadEfectiva = capacidad,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1, sql union(byName: true)~> union1",
				"union1, select2 union(byName: true)~> union2",
				"union2, select3 union(byName: true)~> union3"
			]
		}
	}
}